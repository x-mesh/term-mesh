#!/usr/bin/env bash
# term-mesh claude wrapper - injects hooks and session tracking
#
# When running inside a term-mesh terminal (CMUX_SURFACE_ID is set), this wrapper
# intercepts `claude` invocations to inject --session-id and --settings flags
# so that Claude Code hooks fire back into term-mesh for notifications/status.
# Outside term-mesh, it passes through to the real claude binary unchanged.

# Find the real claude binary, skipping our own directory and other term-mesh wrappers.
find_real_claude() {
    local self_dir
    self_dir="$(cd "$(dirname "$0")" && pwd)"
    local IFS=:
    for d in $PATH; do
        [[ "$d" == "$self_dir" ]] && continue
        if [[ -x "$d/claude" ]]; then
            # Skip other term-mesh wrapper copies to avoid infinite exec loop
            # (tagged debug app ↔ production app both carry this wrapper)
            head -2 "$d/claude" 2>/dev/null | grep -q "term-mesh claude wrapper" && continue
            printf '%s' "$d/claude" && return 0
        fi
    done
    return 1
}

# Pass through if not in a term-mesh terminal or hooks are disabled.
if [[ -z "$CMUX_SURFACE_ID" || "$CMUX_CLAUDE_HOOKS_DISABLED" == "1" ]]; then
    REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }
    exec "$REAL_CLAUDE" "$@"
fi

# Find real claude.
REAL_CLAUDE="$(find_real_claude)" || { echo "Error: claude not found in PATH" >&2; exit 127; }

# Pass through subcommands that don't support session/hook flags.
case "${1:-}" in
    mcp|config|api-key) exec "$REAL_CLAUDE" "$@" ;;
esac

# Pass through headless/pipe mode — no interactive session to track.
# Detects: -p flag, --print flag, or stdin piped (not a terminal).
for arg in "$@"; do
    case "$arg" in
        -p|--print) exec "$REAL_CLAUDE" "$@" ;;
    esac
done
if [[ ! -t 0 ]]; then
    exec "$REAL_CLAUDE" "$@"
fi

# Unset CLAUDECODE to avoid "nested session" detection — term-mesh terminals are
# independent sessions even when the parent shell was launched from Claude Code.
unset CLAUDECODE

# Check if the user already specified a session/resume flag.
# If so, don't inject our own --session-id (it would conflict).
SKIP_SESSION_ID=false
for arg in "$@"; do
    case "$arg" in
        --resume|--resume=*|--session-id|--session-id=*|--continue|-c)
            SKIP_SESSION_ID=true
            break
            ;;
    esac
done

# Build hooks settings JSON.
# Claude Code merges --settings additively with the user's own settings.json.
# The leader-turn hook itself authorizes on TERMMESH_LEADER_REQUEST_TOKEN, which
# only leader panes receive. It is therefore safe to install these callbacks
# for every wrapped Claude session: worker and ordinary user sessions exit
# before reading a payload or touching the turn log. Keep the hook path in an
# inherited variable instead of interpolating a bundle path into JSON; app
# bundle paths can contain spaces and this preserves the command boundary.
WRAPPER_DIR="$(cd "$(dirname "$0")" && pwd)"
LEADER_TURN_HOOK="$WRAPPER_DIR/../scripts/leader-turn-hook.sh"
if [[ -x "$LEADER_TURN_HOOK" ]]; then
    export TERMMESH_LEADER_TURN_HOOK="$LEADER_TURN_HOOK"
    HOOKS_JSON='{"hooks":{"SessionStart":[{"matcher":"","hooks":[{"type":"command","command":"term-mesh claude-hook session-start","timeout":10}]}],"UserPromptSubmit":[{"matcher":"","hooks":[{"type":"command","command":"\"$TERMMESH_LEADER_TURN_HOOK\" --start","timeout":10}]}],"Stop":[{"matcher":"","hooks":[{"type":"command","command":"term-mesh claude-hook stop","timeout":10},{"type":"command","command":"\"$TERMMESH_LEADER_TURN_HOOK\" --end","timeout":10}]}],"Notification":[{"matcher":"","hooks":[{"type":"command","command":"term-mesh claude-hook notification","timeout":10}]}]}}'
else
    # A partial/source installation can contain the wrapper without the hook.
    # Preserve established callbacks; never inject an empty command.
    HOOKS_JSON='{"hooks":{"SessionStart":[{"matcher":"","hooks":[{"type":"command","command":"term-mesh claude-hook session-start","timeout":10}]}],"Stop":[{"matcher":"","hooks":[{"type":"command","command":"term-mesh claude-hook stop","timeout":10}]}],"Notification":[{"matcher":"","hooks":[{"type":"command","command":"term-mesh claude-hook notification","timeout":10}]}]}}'
fi

if [[ "$SKIP_SESSION_ID" == true ]]; then
    exec "$REAL_CLAUDE" --settings "$HOOKS_JSON" "$@"
else
    SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    exec "$REAL_CLAUDE" --session-id "$SESSION_ID" --settings "$HOOKS_JSON" "$@"
fi
