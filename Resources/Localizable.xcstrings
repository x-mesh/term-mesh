    "Cmd+C in a terminal stores the text on disk for 7 days, unencrypted.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 Cmd+C로 복사한 텍스트를 암호화하지 않고 7일 동안 디스크에 저장합니다."
          }
        }
      }
    },
    "Cmd+Q quits immediately without confirmation.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cmd+Q를 누르면 확인 없이 바로 종료합니다."
          }
        }
      }
    },
    "Command Palette rename keeps the caret at the end.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command Palette에서 이름을 바꿀 때 커서를 맨 뒤에 둡니다."
