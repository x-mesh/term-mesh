        }
      }
    },
    "Tracks projects and team leaders across machines. Needs TERMMESH_COORDINATOR_ENABLED=1 in the environment to actually launch the coordinator.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 머신의 프로젝트와 팀 리더를 추적합니다. 코디네이터를 실제로 실행하려면 환경 변수에 TERMMESH_COORDINATOR_ENABLED=1이 필요합니다."
          }
        }
      }
    },
    "Tracks projects, hosts, and team leaders across machines via the coordinator.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코디네이터를 통해 여러 머신의 프로젝트, 호스트, 팀 리더를 추적합니다."
          }
        }
      }
    },
