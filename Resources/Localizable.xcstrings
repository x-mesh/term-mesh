        "ko": { "stringUnit": { "state": "translated", "value": "적용할 프로젝트 이름을 쉼표로 구분해 입력합니다. 기본으로 선택되는 프로젝트는 없습니다." } }
      }
    },
    "Kill Switch": {
      "localizations": {
        "ko": { "stringUnit": { "state": "translated", "value": "긴급 중지" } }
      }
    },
    "Leader Participation": {
      "localizations": {
        "ko": { "stringUnit": { "state": "translated", "value": "리더 참여 방식" } }
      }
    },
    "Returns every existing local leader to static behavior on its next route evaluation.": {
      "localizations": {
        "ko": { "stringUnit": { "state": "translated", "value": "실행 중인 모든 리더를 다음 경로 평가부터 기존 고정 동작으로 되돌립니다." } }
      }
    },
    "Shadow": {
      "localizations": {
        "ko": { "stringUnit": { "state": "translated", "value": "관찰만" } }
      }
    },
    "Shadow only records suggestions. Canary applies observable tm-agent dispatch bounds only after health gates pass.": {
      "localizations": {
        "ko": { "stringUnit": { "state": "translated", "value": "관찰만 모드에서는 제안만 기록합니다. 시험 적용은 상태 기준을 통과한 뒤 tm-agent로 확인 가능한 작업 분배 범위에만 반영됩니다." } }
      }
    },
    "project-a, project-b": {
      "localizations": {
        "ko": { "stringUnit": { "state": "translated", "value": "프로젝트-a, 프로젝트-b" } }
      }
    },
    "Off": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끔"
          }
        }
      }
    },
    "One KEY=VALUE per line.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 KEY=VALUE 하나씩 적습니다."
          }
        }
      }
    },
    "One host or wildcard per line (for example: localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 호스트 하나 또는 와일드카드를 적습니다(예: localhost, 127.0.0.1, ::1, 0.0.0.0, *.localtest.me)."
          }
        }
      }
    },
    "Only accessible from this Mac (127.0.0.1).": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서만 접근할 수 있습니다(127.0.0.1)."
          }
        }
      }
    },
    "Only copied images are stored. Text copies are never written to disk.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
